<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
        "-//Puppy Crawl//DTD Check Configuration 1.3//EN"
        "http://checkstyle.sourceforge.net/dtds/configuration_1_3.dtd">

<!--
    The single Checkstyle configuration used by the Maven build (see the
    maven-checkstyle-plugin configuration in the root pom.xml).

    Rules are organised into two tiers:

      * ENFORCED (severity=error) - currently clean across every source root in
        the repository, so they fail the build. Adding a violation is a
        regression and CI blocks it.

      * STAGED (severity=warning) - conventions the project wants but that the
        existing code base does not yet satisfy. They are reported on every
        build so contributors get feedback, but they do not fail it. The
        comment on each rule records the number of violations at the time it
        was staged; drive one to zero, then promote it to the enforced tier by
        adding a severity=error property to that rule (staged rules carry no
        severity property of their own - they inherit the Checker default
        below).

    The Checker-level default severity below is "warning" on purpose: a rule
    added to this file is non-blocking until somebody explicitly promotes it.
    That makes it safe to grow this configuration incrementally.

    Violation counts were measured with Checkstyle 13.9.0 over all
    src/main/java and src/test/java roots (121 roots, 2168 files).
-->
<module name="Checker">

    <property name="localeLanguage" value="en"/>

    <!-- Staged rules stay non-blocking unless they opt in to severity=error. -->
    <property name="severity" value="warning"/>

    <!-- ==================================================================
         ENFORCED - build fails on violation
         ================================================================== -->

    <module name="FileTabCharacter">
        <property name="severity" value="error"/>
    </module>

    <!-- Make @SuppressWarnings annotations visible to Checkstyle. -->
    <module name="SuppressWarningsFilter"/>

    <module name="TreeWalker">

        <!-- imports -->
        <module name="UnusedImports">
            <property name="severity" value="error"/>
            <property name="processJavadoc" value="true"/>
        </module>
        <module name="RedundantImport">
            <property name="severity" value="error"/>
        </module>
        <module name="IllegalImport">
            <property name="severity" value="error"/>
        </module>

        <!-- code cleanup -->
        <module name="OneStatementPerLine">
            <property name="severity" value="error"/>
        </module>
        <module name="DefaultComesLast">
            <property name="severity" value="error"/>
        </module>
        <module name="UpperEll">
            <property name="severity" value="error"/>
        </module>

        <!-- naming -->
        <module name="PackageName">
            <property name="severity" value="error"/>
        </module>
        <module name="ClassTypeParameterName">
            <property name="severity" value="error"/>
            <property name="format" value="^[A-Z][a-zA-Z0-9]*$$"/>
        </module>
        <module name="MethodTypeParameterName">
            <property name="severity" value="error"/>
            <property name="format" value="^[A-Z][a-zA-Z0-9]*$$"/>
        </module>
        <module name="InterfaceTypeParameterName">
            <property name="severity" value="error"/>
            <property name="format" value="^[A-Z][a-zA-Z0-9]*$$"/>
        </module>

        <!-- whitespace -->
        <module name="MethodParamPad">
            <property name="severity" value="error"/>
        </module>
        <module name="TypecastParenPad">
            <property name="severity" value="error"/>
        </module>

        <!-- ==============================================================
             STAGED - reported as warnings, do not fail the build
             ============================================================== -->

        <!-- code cleanup -->
        <module name="EqualsHashCode"/>             <!-- 1 violation -->
        <module name="SimplifyBooleanExpression"/>  <!-- 1 violation -->
        <module name="SimplifyBooleanReturn"/>      <!-- 1 violation -->
        <module name="EmptyStatement"/>             <!-- 2 violations -->
        <module name="UnnecessaryParentheses"/>     <!-- 158 violations -->

        <!-- style -->
        <module name="ArrayTypeStyle"/>             <!-- 1 violation -->
        <module name="LeftCurly"/>                  <!-- 25 violations -->
        <module name="RightCurly"/>                 <!-- 83 violations -->
        <module name="AvoidStarImport"/>            <!-- 125 violations -->

        <!-- naming -->
        <module name="TypeName"/>                   <!-- 1 violation -->
        <module name="ParameterName"/>              <!-- 4 violations -->
        <module name="LocalFinalVariableName"/>     <!-- 13 violations -->
        <module name="StaticVariableName"/>         <!-- 19 violations -->
        <module name="LocalVariableName"/>          <!-- 52 violations -->
        <module name="MemberName"/>                 <!-- 58 violations -->
        <module name="ConstantName">                <!-- 170 violations -->
            <property name="format" value="(^[A-Z][A-Z0-9]*(_[A-Z0-9]+)*$)|(^log$)"/>
        </module>

        <!-- whitespace -->
        <module name="NoWhitespaceBefore"/>         <!-- 1 violation -->
        <module name="ParenPad"/>                   <!-- 1 violation -->
        <module name="GenericWhitespace"/>          <!-- 5 violations -->
        <module name="WhitespaceAfter"/>            <!-- 11 violations -->
        <module name="WhitespaceAround">            <!-- 42 violations -->
            <property name="allowEmptyConstructors" value="true"/>
            <property name="allowEmptyMethods" value="true"/>
        </module>
        <module name="NoWhitespaceAfter"/>          <!-- 54 violations -->
        <module name="Indentation"/>                <!-- 467 violations -->

        <!--
            Locale-sensitive methods should specify a Locale.

            PROMOTE THIS ONE FIRST. Unlike the whitespace and brace rules
            around it, this catches real defects rather than style drift -
            the default locale makes toUpperCase()/toLowerCase() behave
            differently per JVM (the Turkish dotless-i problem). The project
            has already had to fix two such bugs in production code: #9075
            (Elasticsearch state filter) and #8922 (RulesPropertiesImpl).

            134 violations: 76 under src/main, 58 under src/test. The
            production half is concentrated - 31 in app, 11 in
            utils/maven-plugin - so it is tractable in one focused pass.
        -->
        <module name="Regexp">
            <property name="format" value="\.to(Lower|Upper)Case\(\)"/>
            <property name="illegalPattern" value="true"/>
            <property name="ignoreComments" value="true"/>
        </module>

        <!-- code quality -->
        <module name="ParameterNumber">             <!-- 5 violations -->
            <!-- default is 8 -->
            <property name="max" value="13"/>
        </module>
        <module name="ClassDataAbstractionCoupling"><!-- 9 violations -->
            <!-- default is 7 -->
            <property name="max" value="20"/>
        </module>
        <module name="BooleanExpressionComplexity"> <!-- 11 violations -->
            <!-- default is 3 -->
            <property name="max" value="5"/>
        </module>
        <module name="JavaNCSS">                    <!-- 12 violations -->
            <!-- default is 50 -->
            <property name="methodMaximum" value="100"/>
        </module>
        <module name="MethodLength"/>               <!-- 16 violations, default max is 150 -->
        <module name="ClassFanOutComplexity">       <!-- 16 violations -->
            <!-- default is 20 -->
            <property name="max" value="44"/>
        </module>
        <module name="NPathComplexity">             <!-- 29 violations -->
            <!-- default is 200 -->
            <property name="max" value="5832"/>
        </module>
        <module name="CyclomaticComplexity">        <!-- 31 violations -->
            <!-- default is 10 -->
            <property name="max" value="19"/>
        </module>
        <module name="IllegalToken">                <!-- 17 violations -->
            <property name="tokens" value="LITERAL_ASSERT"/>
        </module>

        <!-- Collects @SuppressWarnings for SuppressWarningsFilter. -->
        <module name="SuppressWarningsHolder"/>
    </module>

    <!--
        Per-file Apache license headers are deliberately NOT checked.
        Only 143 of 2168 Java files carry one, and the majority of newly added
        files do not; the repository-root LICENSE governs instead. To adopt
        them, land a separate PR that adds the header everywhere, then enable
        the rule below and restore <headerLocation> in the root pom.xml.

        <module name="RegexpHeader">
            <property name="severity" value="error"/>
            <property name="headerFile" value="${checkstyle.header.file}"/>
            <property name="fileExtensions" value="java"/>
        </module>
    -->

    <module name="SuppressionFilter">
        <property name="file" value="${checkstyle.suppressions.file}"/>
    </module>

</module>
