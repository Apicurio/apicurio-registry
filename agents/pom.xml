  <artifactId>apicurio-registry-agents</artifactId>
  <packaging>jar</packaging>
  <name>Registry :: Agents</name>
  <description>Agent registry features (A2A, MCP tools and MCP Registry, AI Catalog, ARD, prompt rendering).
    Depends on the app module; the app module must never depend on this one.</description>

  <properties>
    <projectRoot>${project.basedir}/..</projectRoot>
    <maven.compiler.release>21</maven.compiler.release>
    <groups/>
    <!-- See app/pom.xml -->
    <argLine/>
    <!-- Quarkus builds one application per test profile during discovery; the whole agents suite
         (45 profiles) in one JVM ran out of 4g. CI splits it into two shards with 4g each. -->
    <surefire.maxHeap>8g</surefire.maxHeap>
    <surefire.forkCount>1</surefire.forkCount>
  </properties>

  <dependencies>
    <dependency>
      <groupId>io.apicurio</groupId>
      <artifactId>apicurio-registry-app</artifactId>
    </dependency>
    <dependency>
      <groupId>io.apicurio</groupId>
      <artifactId>apicurio-registry-schema-util-agents</artifactId>
    </dependency>
    <!-- Same override as in app and quarkus-app: without it this module resolves the older
         snakeyaml managed by the Quarkus BOM. -->
    <dependency>
      <groupId>org.yaml</groupId>
      <artifactId>snakeyaml</artifactId>
      <version>${snakeyaml.version}</version>
    </dependency>
    <!-- MCP client used to import tools from live MCP servers -->
    <dependency>
      <groupId>io.modelcontextprotocol.sdk</groupId>
      <artifactId>mcp-core</artifactId>
    </dependency>
    <!-- JWS verification of signed A2A Agent Cards; the version is managed by the Quarkus BOM. -->
    <dependency>
      <groupId>org.bitbucket.b_c</groupId>
      <artifactId>jose4j</artifactId>
    </dependency>

<!-- Test Only -->
