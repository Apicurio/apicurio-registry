      <scope>test</scope>
    </dependency>

  </dependencies>

  <build>
    <resources>
      <resource>
        <filtering>true</filtering>
        <directory>src/main/resources</directory>
      </resource>
      <resource>
        <filtering>false</filtering>
        <directory>src/main/resources-unfiltered</directory>
      </resource>
    </resources>

    <plugins>
      <plugin>
        <groupId>io.apicurio</groupId>
        <artifactId>apicurio-codegen-maven-plugin</artifactId>
        <version>${version.apicurio-codegen-plugin}</version>
        <executions>
          <execution>
            <id>generate-api-mcp-registry-v0</id>
            <goals>
              <goal>generate</goal>
            </goals>
            <phase>generate-sources</phase>
            <configuration>
              <projectSettings>
                <javaPackage>io.apicurio.registry.agents.mcpregistry.rest.v0</javaPackage>
                <generatesOpenApi>false</generatesOpenApi>
                <capitalizeEnumValues>false</capitalizeEnumValues>
              </projectSettings>
              <inputSpec>${project.basedir}/src/main/resources-unfiltered/META-INF/resources/api-specifications/mcp-registry/v0/openapi.json</inputSpec>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>build-helper-maven-plugin</artifactId>
        <version>${version.build.helper.maven.plugin}</version>
        <executions>
          <execution>
            <id>addSource</id>
            <goals>
              <goal>add-source</goal>
            </goals>
            <phase>generate-sources</phase>
            <configuration>
              <sources>
                <source>${project.basedir}/target/generated-sources/jaxrs</source>
              </sources>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <executions>
          <execution>
            <id>default-test</id>
            <configuration>
              <excludedGroups>experimental-startup</excludedGroups>
            </configuration>
          </execution>
          <execution>
            <id>default-cli</id>
            <configuration>
              <!-- Direct surefire:test must also exclude the separate QuarkusUnitTest JVM. -->
              <excludedGroups>experimental-startup</excludedGroups>
            </configuration>
          </execution>
          <execution>
            <id>experimental-startup-test</id>
            <goals><goal>test</goal></goals>
            <configuration>
              <!-- QuarkusUnitTest and QuarkusTest must not share a JVM. -->
              <groups>experimental-startup</groups>
              <test>McpRegistryExperimentalStartupTest</test>
              <forkCount>1</forkCount>
              <reuseForks>false</reuseForks>
              <reportsDirectory>${project.build.directory}/surefire-reports-startup</reportsDirectory>
              <!-- Without the app-tests index-dependency below: this test removes the app artifacts
                   from its deployment (see McpRegistryExperimentalStartupTest). -->
              <systemPropertyVariables combine.self="override">
                <java.util.logging.manager>org.jboss.logmanager.LogManager</java.util.logging.manager>
                <org.jboss.logging.provider>jboss</org.jboss.logging.provider>
                <project.build.directory>${project.build.directory}</project.build.directory>
              </systemPropertyVariables>
            </configuration>
          </execution>
        </executions>
        <configuration>
          <groups>${groups}</groups>
          <!-- Same settings as app/pom.xml: one fork, explicit heap (issue #9265). -->
          <forkCount>${surefire.forkCount}</forkCount>
          <argLine>@{argLine} -Xmx${surefire.maxHeap}</argLine>
          <forkedProcessExitTimeoutInSeconds>1800</forkedProcessExitTimeoutInSeconds>
          <systemPropertyVariables>
            <java.util.logging.manager>org.jboss.logmanager.LogManager</java.util.logging.manager>
            <org.jboss.logging.provider>jboss</org.jboss.logging.provider>
            <project.build.directory>${project.build.directory}</project.build.directory>
            <io.opentelemetry.context.contextStorageProvider>default</io.opentelemetry.context.contextStorageProvider>
            <!-- The app test-jar has no Jandex index; index it so its test beans (mocks, test
                 resources) are discovered as they are in the app module's own tests. -->
            <quarkus.index-dependency.app-tests.group-id>io.apicurio</quarkus.index-dependency.app-tests.group-id>
            <quarkus.index-dependency.app-tests.artifact-id>apicurio-registry-app</quarkus.index-dependency.app-tests.artifact-id>
            <quarkus.index-dependency.app-tests.classifier>tests</quarkus.index-dependency.app-tests.classifier>
          </systemPropertyVariables>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
