{
  "openapi": "3.0.2",
  "info": {
    "title": "MCP Registry API",
    "version": "0.1.0",
    "description": "Apicurio Registry implementation of the official Model Context Protocol (MCP) Registry API. Clients that speak the official API can be pointed at the base URL '/apis/mcp-registry', keeping the specified '/v0.1/...' paths intact.",
    "license": {
      "name": "Apache 2.0",
      "url": "https://www.apache.org/licenses/LICENSE-2.0"
    }
  },
  "paths": {
    "/apis/mcp-registry/v0.1/servers": {
      "get": {
        "operationId": "listServers",
        "tags": [
          "Servers"
        ],
        "summary": "List servers",
        "description": "List all MCP server versions, with optional version, search and timestamp filtering. Results are paginated with an opaque cursor.",
        "parameters": [
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "description": "Opaque cursor returned as 'nextCursor' by a previous call. Must be used with the same filters as the call that produced it.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "Maximum number of servers to return.",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 30
            }
          },
          {
            "name": "search",
            "in": "query",
            "required": false,
            "description": "Free-text search over the server name and description.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "updated_since",
            "in": "query",
            "required": false,
            "description": "Only return servers modified at or after this RFC 3339 timestamp.",
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "version",
            "in": "query",
            "required": false,
            "description": "Omit to return all versions. Use 'latest' for the latest version of each server, or an exact version string.",
            "schema": {
              "type": "string"
            }
          },
          { "$ref": "#/components/parameters/include_deleted" }
        ],
        "responses": {
          "200": {
            "description": "A page of MCP servers",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ServerList"
                }
              }
            }
          },
          "401": { "$ref": "#/components/responses/UnauthorizedError" },
          "403": { "$ref": "#/components/responses/ForbiddenError" },
          "500": { "$ref": "#/components/responses/InternalError" },
          "503": { "$ref": "#/components/responses/UnavailableError" },
          "400": {
            "$ref": "#/components/responses/BadRequestError",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/apis/mcp-registry/v0.1/servers/{serverName}": {
      "get": {
        "operationId": "getServer",
        "tags": [
          "Servers"
        ],
        "summary": "Get a server",
        "description": "Get the latest version of a single MCP server.",
        "parameters": [
          {
            "$ref": "#/components/parameters/serverName"
          },
          { "$ref": "#/components/parameters/include_deleted" }
        ],
        "responses": {
          "200": {
            "description": "The latest version of the server",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ServerResponse"
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequestError" },
          "401": { "$ref": "#/components/responses/UnauthorizedError" },
          "403": { "$ref": "#/components/responses/ForbiddenError" },
          "500": { "$ref": "#/components/responses/InternalError" },
          "503": { "$ref": "#/components/responses/UnavailableError" },
          "404": {
            "$ref": "#/components/responses/NotFoundError",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/apis/mcp-registry/v0.1/servers/{serverName}/versions": {
      "get": {
        "operationId": "listServerVersions",
        "tags": [
          "Servers"
        ],
        "summary": "List server versions",
        "description": "List versions of a single MCP server, newest first. Deleted versions are excluded unless include_deleted is true.",
        "parameters": [
          {
            "$ref": "#/components/parameters/serverName"
          },
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 30
            }
          },
          { "$ref": "#/components/parameters/include_deleted" }
        ],
        "responses": {
          "200": {
            "description": "A page of server versions",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ServerList"
                }
              }
            }
          },
          "400": {
            "description": "The request is invalid",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequestError" },
          "401": { "$ref": "#/components/responses/UnauthorizedError" },
          "403": { "$ref": "#/components/responses/ForbiddenError" },
          "500": { "$ref": "#/components/responses/InternalError" },
          "503": { "$ref": "#/components/responses/UnavailableError" },
          "404": {
            "$ref": "#/components/responses/NotFoundError",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/apis/mcp-registry/v0.1/servers/{serverName}/versions/{version}": {
      "put": {
        "operationId": "updateServerVersion",
        "tags": ["Servers"],
        "summary": "Optional update operation (unsupported for immutable server versions)",
        "parameters": [
          {"$ref": "#/components/parameters/serverName"},
          {"$ref": "#/components/parameters/version"}
        ],
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Server"}}}},
        "responses": {
          "400": { "$ref": "#/components/responses/BadRequestError" },
          "401": { "$ref": "#/components/responses/UnauthorizedError" },
          "403": { "$ref": "#/components/responses/ForbiddenError" },
          "500": { "$ref": "#/components/responses/InternalError" },
          "503": { "$ref": "#/components/responses/UnavailableError" },
          "501": {"description": "Registry does not support in-place updates", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}}
        }
      },
      "get": {
        "operationId": "getServerVersion",
        "tags": [
          "Servers"
        ],
        "summary": "Get a server version",
        "parameters": [
          {
            "$ref": "#/components/parameters/serverName"
          },
          {
            "$ref": "#/components/parameters/version"
          },
          { "$ref": "#/components/parameters/include_deleted" }
        ],
        "responses": {
          "200": {
            "description": "The requested version of the server",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ServerResponse"
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequestError" },
          "401": { "$ref": "#/components/responses/UnauthorizedError" },
          "403": { "$ref": "#/components/responses/ForbiddenError" },
          "500": { "$ref": "#/components/responses/InternalError" },
          "503": { "$ref": "#/components/responses/UnavailableError" },
          "404": {
            "$ref": "#/components/responses/NotFoundError",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "delete": {
        "operationId": "deleteServerVersion",
        "tags": [
          "Servers"
        ],
        "summary": "Soft-delete a server version",
        "description": "Mark the version deleted while retaining content and history. Permanent removal is available only through the native Registry API and its deletion gate.",
        "parameters": [
          {
            "$ref": "#/components/parameters/serverName"
          },
          {
            "$ref": "#/components/parameters/version"
          }
        ],
        "responses": {
          "200": {
            "description": "The deleted server version",
            "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ServerResponse"}}}
          },
          "503": { "$ref": "#/components/responses/UnavailableError" },
          "400": {
            "description": "The request is invalid",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Authentication is required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "The caller is not allowed to modify this server",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFoundError",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "501": {
            "description": "The registry does not support modifying servers, because its storage is read-only",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/apis/mcp-registry/v0.1/servers/{serverName}/versions/{version}/status": {
      "patch": {
        "operationId": "updateServerVersionStatus",
        "tags": [
          "Servers"
        ],
        "summary": "Update the status of a server version",
        "parameters": [
          {
            "$ref": "#/components/parameters/serverName"
          },
          {
            "$ref": "#/components/parameters/version"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/StatusUpdate"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The updated server version",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ServerResponse"
                }
              }
            }
          },
          "500": { "$ref": "#/components/responses/InternalError" },
          "503": { "$ref": "#/components/responses/UnavailableError" },
          "400": {
            "description": "The request is invalid",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Authentication is required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "The caller is not allowed to modify this server",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFoundError",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "501": {
            "description": "The registry does not support modifying servers, because its storage is read-only",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/apis/mcp-registry/v0.1/servers/{serverName}/status": {
      "patch": {
        "operationId": "updateServerStatus",
        "tags": [
          "Servers"
        ],
        "summary": "Update the status of every version of a server",
        "parameters": [
          {
            "$ref": "#/components/parameters/serverName"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/StatusUpdate"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "All updated server versions",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AllVersionsStatusResponse"
                }
              }
            }
          },
          "500": { "$ref": "#/components/responses/InternalError" },
          "503": { "$ref": "#/components/responses/UnavailableError" },
          "400": {
            "description": "The request is invalid",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Authentication is required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "The caller is not allowed to modify this server",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFoundError",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "501": {
            "description": "The registry does not support modifying servers, because its storage is read-only",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/apis/mcp-registry/v0.1/publish": {
      "post": {
        "operationId": "publishServer",
        "tags": [
          "Publish"
        ],
        "summary": "Publish a server version",
        "description": "Publish a new MCP server, or a new version of an existing one.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Server"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The published server version",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ServerResponse"
                }
              }
            }
          },
          "413": { "description": "Server manifest exceeds the request limit", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}} },
          "503": { "$ref": "#/components/responses/UnavailableError" },
          "400": {
            "$ref": "#/components/responses/BadRequestError",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Authentication is required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "The caller is not allowed to modify this server",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "$ref": "#/components/responses/ConflictError",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "501": {
            "description": "The registry does not support modifying servers, because its storage is read-only",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "parameters": {
      "include_deleted": {
        "name": "include_deleted",
        "in": "query",
        "description": "Include deleted server versions. Always enabled for incremental listing with updated_since.",
        "schema": { "type": "boolean", "default": false }
      },
      "serverName": {
        "name": "serverName",
        "in": "path",
        "required": true,
        "description": "URL-encoded full server name, e.g. io.github.user%2Fweather.",
        "schema": {
          "type": "string"
        }
      },
      "version": {
        "name": "version",
        "in": "path",
        "required": true,
        "description": "The server version, or 'latest' for the most recently published one.",
        "schema": {
          "type": "string"
        }
      }
    },
    "responses": {
      "UnauthorizedError": {
        "description": "Authentication required (Apicurio error declaration beyond upstream minimal responses)",
        "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}
      },
      "ForbiddenError": {
        "description": "Caller is not authorized (Apicurio error declaration beyond upstream minimal responses)",
        "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}
      },
      "InternalError": {
        "description": "Internal failure; implementation details are not exposed (Apicurio error declaration)",
        "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}
      },
      "UnavailableError": {
        "description": "Service unavailable or storage operation timed out (Apicurio error declaration)",
        "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}
      },
      "BadRequestError": {
        "description": "The request was malformed",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "NotFoundError": {
        "description": "No such server or version",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "ConflictError": {
        "description": "The server version already exists",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      }
    },
    "schemas": {
      "AllVersionsStatusResponse": {
        "type": "object", "required": ["updatedCount", "servers"],
        "properties": {
          "updatedCount": {"type": "integer"},
          "servers": {"type": "array", "items": {"$ref": "#/components/schemas/ServerResponse"}}
        }
      },
      "Server": {
        "description": "An MCP server definition (server.json), including publisher extension metadata under '_meta'. Validated using the pinned 2025-12-11 schema.",
        "type": "object",
        "additionalProperties": true,
        "required": [
          "name",
          "description",
          "version"
        ],
        "properties": {
          "name": {
            "type": "string",
            "description": "Reverse-DNS server name, e.g. 'io.github.user/weather'."
          },
          "version": {
            "type": "string",
            "description": "The version of this server definition."
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "websiteUrl": {
            "type": "string"
          },
          "repository": {
            "$ref": "#/components/schemas/Repository"
          },
          "packages": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Package"
            }
          },
          "remotes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Remote"
            }
          },
          "icons": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Icon"
            }
          },
          "_meta": {
            "$ref": "#/components/schemas/Meta"
          }
        }
      },
      "Repository": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "url"
        ],
        "properties": {
          "url": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "subfolder": {
            "type": "string"
          }
        }
      },
      "Package": {
        "description": "How to install and run the server. Fields beyond those named here are preserved verbatim.",
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "registryType": {
            "type": "string"
          },
          "registryBaseUrl": {
            "type": "string"
          },
          "identifier": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "fileSha256": {
            "type": "string"
          },
          "runtimeHint": {
            "type": "string"
          },
          "transport": {
            "$ref": "#/components/schemas/Transport"
          }
        }
      },
      "Remote": {
        "description": "A remote transport endpoint the server can be reached at.",
        "type": "object",
        "additionalProperties": true,
        "required": [
          "type",
          "url"
        ],
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "streamable-http",
              "sse"
            ]
          },
          "url": {
            "type": "string"
          }
        }
      },
      "Transport": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "stdio",
              "streamable-http",
              "sse"
            ]
          },
          "url": {
            "type": "string"
          }
        }
      },
      "Icon": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "src"
        ],
        "properties": {
          "src": {
            "type": "string"
          },
          "mimeType": {
            "type": "string"
          },
          "sizes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "theme": {
            "type": "string"
          }
        }
      },
      "Meta": {
        "description": "Extension metadata. Registry-managed fields live under the 'io.modelcontextprotocol.registry/official' key.",
        "type": "object",
        "additionalProperties": true,
        "properties": {}
      },
      "RegistryMeta": {
        "description": "The registry-managed metadata block stored under '_meta[\"io.modelcontextprotocol.registry/official\"]'.",
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "id": {
            "type": "string"
          },
          "publishedAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "isLatest": {
            "type": "boolean"
          },
          "status": {
            "$ref": "#/components/schemas/ServerStatus"
          }
        }
      },
      "ServerStatus": {
        "type": "string",
        "enum": [
          "active",
          "deprecated",
          "deleted"
        ]
      },
      "StatusUpdate": {
        "type": "object",
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "$ref": "#/components/schemas/ServerStatus"
          },
          "statusMessage": {
            "type": "string",
            "maxLength": 500,
            "description": "Optional human-readable reason for the status change, supported for every status."
          }
        }
      },
      "ServerResponse": {
        "description": "Server definition and registry-owned metadata, as separate objects.",
        "type": "object",
        "required": ["server"],
        "properties": {
          "server": { "$ref": "#/components/schemas/Server" },
          "_meta": { "$ref": "#/components/schemas/Meta" }
        }
      },
      "ServerList": {
        "type": "object",
        "required": [
          "servers"
        ],
        "properties": {
          "servers": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ServerResponse"
            }
          },
          "metadata": {
            "$ref": "#/components/schemas/ListMetadata"
          }
        }
      },
      "ListMetadata": {
        "type": "object",
        "properties": {
          "nextCursor": {
            "type": "string",
            "description": "Cursor to pass to the next call. Absent when this is the last page."
          },
          "count": {
            "type": "integer",
            "description": "Number of servers in this page."
          }
        }
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          }
        }
      }
    }
  }
}
