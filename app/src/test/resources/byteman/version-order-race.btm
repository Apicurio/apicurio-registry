# Freeze first writer at entry; release when second writer exits.
# Validates SELECT FOR UPDATE serializes concurrent version creation.

RULE freeze first writer
CLASS io.apicurio.registry.storage.impl.sql.AbstractSqlRegistryStorage
METHOD createArtifactVersion(java.lang.String, java.lang.String, java.lang.String, java.lang.String, io.apicurio.registry.storage.dto.ContentWrapperDto, io.apicurio.registry.storage.dto.EditableVersionMetaDataDto, java.util.List, boolean, boolean, java.lang.String)
AT ENTRY
IF NOT flagged("writer-entered")
DO flag("writer-entered");
   java.lang.System.setProperty("byteman.writerFrozen", "true");
   waitFor("versionOrder-race", 10000)
ENDRULE

RULE release frozen writer
CLASS io.apicurio.registry.storage.impl.sql.AbstractSqlRegistryStorage
METHOD createArtifactVersion(java.lang.String, java.lang.String, java.lang.String, java.lang.String, io.apicurio.registry.storage.dto.ContentWrapperDto, io.apicurio.registry.storage.dto.EditableVersionMetaDataDto, java.util.List, boolean, boolean, java.lang.String)
AT EXIT
IF flagged("writer-entered") AND NOT flagged("writer-released")
DO flag("writer-released");
   signalWake("versionOrder-race", true)
ENDRULE
