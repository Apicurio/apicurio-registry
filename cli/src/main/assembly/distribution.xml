<assembly>
    <id>${os.detected.classifier}</id>
    <formats>
        <format>zip</format>
    </formats>
    <includeBaseDirectory>false</includeBaseDirectory>
    <files>
        <file>
            <source>${project.build.directory}/${project.build.finalName}-runner${executable.suffix}</source>
            <destName>acr_runner${executable.suffix}</destName>
            <outputDirectory>/</outputDirectory>
            <fileMode>0755</fileMode>
        </file>
        <file>
            <source>${project.build.directory}/acr_completions</source>
            <outputDirectory>/</outputDirectory>
        </file>
        <file>
            <source>${project.basedir}/README.md</source>
            <outputDirectory>/</outputDirectory>
        </file>
        <file>
            <source>${project.build.directory}/filtered-scripts/config.json</source>
            <outputDirectory>/</outputDirectory>
        </file>
    </files>
    <fileSets>
        <!-- Common scripts (acr wrapper). Excluded on Windows, where acr.cmd replaces the POSIX
             launcher; cli.common.scripts.excludes is empty everywhere else. -->
        <fileSet>
            <directory>${project.basedir}/src/main/scripts/common</directory>
            <outputDirectory>/</outputDirectory>
            <includes>
                <include>acr</include>
            </includes>
            <excludes>
                <exclude>${cli.common.scripts.excludes}</exclude>
            </excludes>
            <fileMode>0755</fileMode>
        </fileSet>
        <!-- OS-specific scripts (acr_env) — selected by os.detected.name (linux or osx) -->
        <fileSet>
            <directory>${project.basedir}/src/main/scripts/${os.detected.name}</directory>
            <outputDirectory>/</outputDirectory>
            <includes>
                <include>*</include>
            </includes>
            <fileMode>0755</fileMode>
        </fileSet>
    </fileSets>
</assembly>
