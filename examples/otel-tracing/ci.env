# CI settings for verify-examples.yaml (see examples/TEMPLATE.md).
# The producer, consumers, order service and Debezium SMT use the serdes of this checkout: build.sh.
CI_NEEDS_BUILD=true
# Building, then five locally built images, Kafka, PostgreSQL, the registry, the Collector and
# Jaeger take longer than the default 20 minutes
CI_TIMEOUT_MINUTES=30
