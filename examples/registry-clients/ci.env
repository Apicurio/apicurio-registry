# CI settings for verify-examples.yaml (see examples/TEMPLATE.md).
# build.sh builds every client from this checkout: the Java SDK and the CLI with Maven, the Python
# and TypeScript SDKs with their own toolchains.
CI_NEEDS_BUILD=true
# The Go, Python and TypeScript clients
CI_TOOLCHAINS=go node python
# The first build generates and compiles four SDKs and the CLI
CI_TIMEOUT_MINUTES=30
