# CI settings for verify-examples.yaml (see examples/TEMPLATE.md).
# One job per storage variant: all of them in one job would take too long. demo.sh starts each
# variant itself (GitOps needs its repository created first).
CI_MATRIX=postgresql mysql mssql kafkasql gitops kubernetesops
CI_TIMEOUT_MINUTES=25
CI_SELF_MANAGED=true
