<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>io.apicurio</groupId>
    <artifactId>apicurio-registry-examples</artifactId>
    <version>3.4.0-SNAPSHOT</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>

  <artifactId>apicurio-registry-examples-tls-clients</artifactId>
  <packaging>jar</packaging>
  <name>Registry :: Examples :: TLS :: Clients</name>

  <properties>
    <projectRoot>${project.basedir}/../../..</projectRoot>
    <!-- Override on the command line: -Dregistry.url=... -Dmtls.url=... (demo.sh does) -->
    <registry.url>https://localhost:8443/apis/registry/v3</registry.url>
    <!-- The same registry by IP address: not a name in its certificate (hostname verification) -->
    <registry.ip.url>https://127.0.0.1:8443/apis/registry/v3</registry.ip.url>
    <mtls.url>https://localhost:9443/apis/registry/v3</mtls.url>
    <kafka.bootstrap>localhost:9092</kafka.bootstrap>
    <!-- Generated by ../certs/generate-certs.sh; every store's password is store.password -->
    <certs>${project.basedir}/../certs</certs>
    <store.password>apicurio</store.password>
    <registry.username>developer</registry.username>
    <registry.password>developer</registry.password>
    <schema>${project.basedir}/src/main/resources/greeting.avsc</schema>
  </properties>

  <dependencies>
    <!-- The Java SDK and the Avro serdes, built from this repository -->
    <dependency>
      <groupId>io.apicurio</groupId>
      <artifactId>apicurio-registry-java-sdk</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.apicurio</groupId>
      <artifactId>apicurio-registry-avro-serde-kafka</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.apache.kafka</groupId>
      <artifactId>kafka-clients</artifactId>
      <version>${kafka.version}</version>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!-- mvn exec:java runs the Java SDK and serdes checks (demo.sh does this) -->
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>3.1.0</version>
        <configuration>
          <mainClass>io.apicurio.registry.examples.tls.Clients</mainClass>
          <arguments>
            <argument>${registry.url}</argument>
            <argument>${registry.ip.url}</argument>
            <argument>${mtls.url}</argument>
            <argument>${certs}</argument>
            <argument>${kafka.bootstrap}</argument>
          </arguments>
        </configuration>
      </plugin>

      <!--
        The Maven plugin over TLS. Nothing is bound to the build: demo.sh runs each execution by id,
        for example `mvn apicurio-registry:register@tls-pkcs12`. Every option is a real parameter of
        the plugin (utils/maven-plugin, AbstractRegistryMojo). The store type comes from the file
        extension (.p12/.pfx, .jks, .pem/.crt/.cer) unless trustStoreType / keyStoreType is set.
      -->
      <plugin>
        <groupId>io.apicurio</groupId>
        <artifactId>apicurio-registry-maven-plugin</artifactId>
        <version>${project.version}</version>
        <executions>
          <!-- registry: server certificate checked with a PKCS12 trust store; HTTP basic credentials -->
          <execution>
            <id>tls-pkcs12</id>
            <goals><goal>register</goal></goals>
            <configuration>
              <registryUrl>${registry.url}</registryUrl>
              <trustStorePath>${certs}/truststore.p12</trustStorePath>
              <trustStorePassword>${store.password}</trustStorePassword>
              <username>${registry.username}</username>
              <password>${registry.password}</password>
              <artifacts>
                <artifact>
                  <groupId>maven-tls</groupId>
                  <artifactId>tls-pkcs12</artifactId>
                  <artifactType>AVRO</artifactType>
                  <file>${schema}</file>
                  <ifExists>FIND_OR_CREATE_VERSION</ifExists>
                </artifact>
              </artifacts>
            </configuration>
          </execution>
          <!-- A JKS trust store -->
          <execution>
            <id>tls-jks</id>
            <goals><goal>register</goal></goals>
            <configuration>
              <registryUrl>${registry.url}</registryUrl>
              <trustStorePath>${certs}/truststore.jks</trustStorePath>
              <trustStorePassword>${store.password}</trustStorePassword>
              <username>${registry.username}</username>
              <password>${registry.password}</password>
              <artifacts>
                <artifact>
                  <groupId>maven-tls</groupId>
                  <artifactId>tls-jks</artifactId>
                  <artifactType>AVRO</artifactType>
                  <file>${schema}</file>
                  <ifExists>FIND_OR_CREATE_VERSION</ifExists>
                </artifact>
              </artifacts>
            </configuration>
          </execution>
          <!-- The CA certificate as a PEM file: no password; the type is explicit here -->
          <execution>
            <id>tls-pem</id>
            <goals><goal>register</goal></goals>
            <configuration>
              <registryUrl>${registry.url}</registryUrl>
              <trustStorePath>${certs}/ca-cert.pem</trustStorePath>
              <trustStoreType>PEM</trustStoreType>
              <username>${registry.username}</username>
              <password>${registry.password}</password>
              <artifacts>
                <artifact>
                  <groupId>maven-tls</groupId>
                  <artifactId>tls-pem</artifactId>
                  <artifactType>AVRO</artifactType>
                  <file>${schema}</file>
                  <ifExists>FIND_OR_CREATE_VERSION</ifExists>
                </artifact>
              </artifacts>
            </configuration>
          </execution>
          <!-- Development only: no certificate or hostname checks, against an address not in the
               certificate. Never use these two options in production -->
          <execution>
            <id>dev-trust-all</id>
            <goals><goal>register</goal></goals>
            <configuration>
              <registryUrl>${registry.ip.url}</registryUrl>
              <trustAll>true</trustAll>
              <verifyHostname>false</verifyHostname>
              <username>${registry.username}</username>
              <password>${registry.password}</password>
              <artifacts>
                <artifact>
                  <groupId>maven-tls</groupId>
                  <artifactId>dev-trust-all</artifactId>
                  <artifactType>AVRO</artifactType>
                  <file>${schema}</file>
                  <ifExists>FIND_OR_CREATE_VERSION</ifExists>
                </artifact>
              </artifacts>
            </configuration>
          </execution>
          <!-- Fails: the default Java trust store does not trust the example CA -->
          <execution>
            <id>no-trust-store</id>
            <goals><goal>register</goal></goals>
            <configuration>
              <registryUrl>${registry.url}</registryUrl>
              <username>${registry.username}</username>
              <password>${registry.password}</password>
              <artifacts>
                <artifact>
                  <groupId>maven-tls</groupId>
                  <artifactId>no-trust-store</artifactId>
                  <artifactType>AVRO</artifactType>
                  <file>${schema}</file>
                </artifact>
              </artifacts>
            </configuration>
          </execution>
          <!-- Fails: the right CA, but 127.0.0.1 is not a name in the server certificate -->
          <execution>
            <id>hostname-mismatch</id>
            <goals><goal>register</goal></goals>
            <configuration>
              <registryUrl>${registry.ip.url}</registryUrl>
              <trustStorePath>${certs}/ca-cert.pem</trustStorePath>
              <username>${registry.username}</username>
              <password>${registry.password}</password>
              <artifacts>
                <artifact>
                  <groupId>maven-tls</groupId>
                  <artifactId>hostname-mismatch</artifactId>
                  <artifactType>AVRO</artifactType>
                  <file>${schema}</file>
                </artifact>
              </artifacts>
            </configuration>
          </execution>
          <!-- Fails: TLS is fine, the password is not (401) -->
          <execution>
            <id>wrong-password</id>
            <goals><goal>register</goal></goals>
            <configuration>
              <registryUrl>${registry.url}</registryUrl>
              <trustStorePath>${certs}/ca-cert.pem</trustStorePath>
              <username>${registry.username}</username>
              <password>wrong</password>
              <artifacts>
                <artifact>
                  <groupId>maven-tls</groupId>
                  <artifactId>wrong-password</artifactId>
                  <artifactType>AVRO</artifactType>
                  <file>${schema}</file>
                </artifact>
              </artifacts>
            </configuration>
          </execution>

          <!-- mtls-proxy: mutual TLS with a PKCS12 key store holding the client certificate -->
          <execution>
            <id>mtls-pkcs12</id>
            <goals><goal>register</goal></goals>
            <configuration>
              <registryUrl>${mtls.url}</registryUrl>
              <trustStorePath>${certs}/truststore.p12</trustStorePath>
              <trustStorePassword>${store.password}</trustStorePassword>
              <keyStorePath>${certs}/client-keystore.p12</keyStorePath>
              <keyStorePassword>${store.password}</keyStorePassword>
              <artifacts>
                <artifact>
                  <groupId>maven-tls</groupId>
                  <artifactId>mtls-pkcs12</artifactId>
                  <artifactType>AVRO</artifactType>
                  <file>${schema}</file>
                  <ifExists>FIND_OR_CREATE_VERSION</ifExists>
                </artifact>
              </artifacts>
            </configuration>
          </execution>
          <!-- Mutual TLS with JKS stores -->
          <execution>
            <id>mtls-jks</id>
            <goals><goal>register</goal></goals>
            <configuration>
              <registryUrl>${mtls.url}</registryUrl>
              <trustStorePath>${certs}/truststore.jks</trustStorePath>
              <trustStorePassword>${store.password}</trustStorePassword>
              <keyStorePath>${certs}/client-keystore.jks</keyStorePath>
              <keyStorePassword>${store.password}</keyStorePassword>
              <artifacts>
                <artifact>
                  <groupId>maven-tls</groupId>
                  <artifactId>mtls-jks</artifactId>
                  <artifactType>AVRO</artifactType>
                  <file>${schema}</file>
                  <ifExists>FIND_OR_CREATE_VERSION</ifExists>
                </artifact>
              </artifacts>
            </configuration>
          </execution>
          <!-- Mutual TLS with PEM files: keyStorePath is the certificate, keyStorePemKeyPath the key -->
          <execution>
            <id>mtls-pem</id>
            <goals><goal>register</goal></goals>
            <configuration>
              <registryUrl>${mtls.url}</registryUrl>
              <trustStorePath>${certs}/ca-cert.pem</trustStorePath>
              <trustStoreType>PEM</trustStoreType>
              <keyStorePath>${certs}/client-cert.pem</keyStorePath>
              <keyStorePemKeyPath>${certs}/client-key.pem</keyStorePemKeyPath>
              <keyStoreType>PEM</keyStoreType>
              <artifacts>
                <artifact>
                  <groupId>maven-tls</groupId>
                  <artifactId>mtls-pem</artifactId>
                  <artifactType>AVRO</artifactType>
                  <file>${schema}</file>
                  <ifExists>FIND_OR_CREATE_VERSION</ifExists>
                </artifact>
              </artifacts>
            </configuration>
          </execution>
          <!-- Fails: the server is trusted, but no client certificate is sent -->
          <execution>
            <id>mtls-no-client-cert</id>
            <goals><goal>register</goal></goals>
            <configuration>
              <registryUrl>${mtls.url}</registryUrl>
              <trustStorePath>${certs}/ca-cert.pem</trustStorePath>
              <artifacts>
                <artifact>
                  <groupId>maven-tls</groupId>
                  <artifactId>mtls-no-client-cert</artifactId>
                  <artifactType>AVRO</artifactType>
                  <file>${schema}</file>
                </artifact>
              </artifacts>
            </configuration>
          </execution>
          <!-- Fails: a client certificate signed by a CA the proxy does not trust -->
          <execution>
            <id>mtls-rogue-client-cert</id>
            <goals><goal>register</goal></goals>
            <configuration>
              <registryUrl>${mtls.url}</registryUrl>
              <trustStorePath>${certs}/ca-cert.pem</trustStorePath>
              <keyStorePath>${certs}/rogue-client-keystore.p12</keyStorePath>
              <keyStorePassword>${store.password}</keyStorePassword>
              <artifacts>
                <artifact>
                  <groupId>maven-tls</groupId>
                  <artifactId>mtls-rogue-client-cert</artifactId>
                  <artifactType>AVRO</artifactType>
                  <file>${schema}</file>
                </artifact>
              </artifacts>
            </configuration>
          </execution>

          <!-- Download over mutual TLS (PKCS12), and over TLS with credentials (PEM) -->
          <execution>
            <id>download-mtls</id>
            <goals><goal>download</goal></goals>
            <configuration>
              <registryUrl>${mtls.url}</registryUrl>
              <trustStorePath>${certs}/truststore.p12</trustStorePath>
              <trustStorePassword>${store.password}</trustStorePassword>
              <keyStorePath>${certs}/client-keystore.p12</keyStorePath>
              <keyStorePassword>${store.password}</keyStorePassword>
              <artifacts>
                <artifact>
                  <groupId>maven-tls</groupId>
                  <artifactId>mtls-pkcs12</artifactId>
                  <file>${project.build.directory}/downloaded/mtls-pkcs12.avsc</file>
                  <overwrite>true</overwrite>
                </artifact>
              </artifacts>
            </configuration>
          </execution>
          <execution>
            <id>download-tls</id>
            <goals><goal>download</goal></goals>
            <configuration>
              <registryUrl>${registry.url}</registryUrl>
              <trustStorePath>${certs}/ca-cert.pem</trustStorePath>
              <username>${registry.username}</username>
              <password>${registry.password}</password>
              <artifacts>
                <artifact>
                  <groupId>maven-tls</groupId>
                  <artifactId>tls-pkcs12</artifactId>
                  <file>${project.build.directory}/downloaded/tls-pkcs12.avsc</file>
                  <overwrite>true</overwrite>
                </artifact>
              </artifacts>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
