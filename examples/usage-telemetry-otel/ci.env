# CI settings of this example (see examples/TEMPLATE.md).
# The browser tests need Node.js and the example's locked Playwright package. The workflow installs the locked packages and the
# operating system packages Chromium needs (never the example's own scripts); the suite then downloads Chromium without privileges.
CI_TOOLCHAINS=node
CI_PLAYWRIGHT_DIR=tests/ui
# After both demo.sh runs and with the stack still up: the unit, dashboard, browser, lifecycle and scenario suites of this example,
# serially, with the artifacts of tests/ci-suite.sh uploaded as example-ci-usage-telemetry-otel.
CI_SUITE=tests/ci-suite.sh
# Two demo runs, the suite and the downloads of the images. Only the unit phase (about 13 minutes) and the stack-free browser phases
# (about 5 more) have been timed; the container phases have not, so this is an estimate to be set from the first runs on a runner. The
# phase deadlines of tests/ci-suite.sh add up to far more, and the job timeout is what ends a hang the deadlines did not.
CI_TIMEOUT_MINUTES=75
