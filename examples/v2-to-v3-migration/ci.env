# CI settings for verify-examples.yaml (see examples/TEMPLATE.md).
# demo.sh starts its own 2.6 and 3.x servers; the 2.6 images are the source of the migration.
CI_SELF_MANAGED=true
CI_TIMEOUT_MINUTES=20
CI_RELEASED_IMAGES=apicurio/apicurio-registry-mem:2.6.13.Final apicurio/apicurio-registry-kafkasql:2.6.13.Final
