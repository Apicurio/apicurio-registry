FROM registry.access.redhat.com/ubi10/openjdk-21-runtime@sha256:23fb65c7e4cbb94bc59d72fcfb8e78f2fdb865e0d1bc2a1e3d45a692a9e7d6ea

# NOTE: -XX:-UseBASE64Intrinsics mitigates CVE-2026-114938 ("Java4Shell"), a memory corruption
# vulnerability in the OpenJDK Base64 decoder on x86-64 CPUs with AVX-512 VBMI support. Remove
# this flag once the base image ships a fixed OpenJDK build.
# See: https://quarkus.io/blog/java4shell/
ENV APP_URL="${docker.app.file}" \
    JAVA_OPTIONS="-Dquarkus.http.host=0.0.0.0 -Djava.util.logging.manager=org.jboss.logmanager.LogManager -XX:-UseBASE64Intrinsics"

ADD "$APP_URL" /deployments

USER root

RUN chmod -R "ug=rwx" /deployments && chown -R 1001:0 /deployments

USER 1001
