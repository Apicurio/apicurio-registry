{
    "asyncapi": "3.0.0",
    "info": {
        "title": "Event Service API",
        "version": "1.0.0",
        "description": "Several messages sharing one referenced Avro schema"
    },
    "components": {
        "messages": {
            "UserEventMessage": {
                "payload": {
                    "$ref": "http://schemas.example.org/user-event.avsc"
                }
            },
            "UserEventVersionlessMessage": {
                "payload": {
                    "schemaFormat": "application/vnd.apache.avro+json",
                    "schema": {
                        "$ref": "http://schemas.example.org/user-event.avsc"
                    }
                }
            },
            "UserEventForeignMessage": {
                "payload": {
                    "schemaFormat": "application/schema+json;version=draft-07",
                    "schema": {
                        "$ref": "http://schemas.example.org/user-event.avsc"
                    }
                }
            }
        }
    }
}
